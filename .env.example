# Analytics e marketing (deixar vazio até integração real)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Leads — encaminhamento para CRM/Apollo/Zapier (opcional)
LEADS_WEBHOOK_URL=

# Leads — notificação por email a cada novo contacto (opcional)
# Criar conta em resend.com, verificar o domínio cqfinancas.com e gerar uma API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=

# Newsletter — fornecedor de email marketing (opcional)
NEWSLETTER_WEBHOOK_URL=

# Chat IA — chave da API Anthropic (opcional; sem chave usa respostas estáticas)
ANTHROPIC_API_KEY=

# Backoffice de leads (Basic Auth) — definir antes de publicar em produção
BACKOFFICE_USER=
BACKOFFICE_PASSWORD=

# reCAPTCHA / Cloudflare Turnstile (anti-spam nos formulários)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Decap CMS — autenticação via GitHub OAuth (ver docs/backoffice.md)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
